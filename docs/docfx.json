{
  "metadata": [
    {
      "src": [{ "src": "../src/Close.DotNet/bin/Release/net10.0", "files": ["Close.DotNet.dll"] }],
      "dest": "api"
    }
  ],
  "build": {
    "content": [{ "files": ["index.md", "guides/**.md", "coverage.md", "toc.yml", "api/**.yml"] }],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Close.DotNet",
      "_appTitle": "Close.DotNet documentation",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
